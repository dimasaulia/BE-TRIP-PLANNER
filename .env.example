# Backend config. Local: copy to BE/.env. Docker Compose: same file, read by
# env_file when the container starts (APP_PORT, REDIS_ADDR, UPLOAD_DIR and LOG_DIR
# are set by docker-compose.yml). For Docker:
#   APP_ENV=production, APP_BASE_URL=https://your-domain, ALLOWED_ORIGINS=https://your-domain
#   DATABASE_URL=postgres://user:pass@<postgres-container-name>:5432/trip_planner?sslmode=disable
#   GOOGLE_*_REDIRECT_URL=https://your-domain/api/v1/...   TRUST_PROXY=true (behind the proxy)

APP_PORT=8080
APP_ENV=development
LOG_LEVEL=info
LOG_DIR=.logs

# Frontend origin. Used for redirects after login, invite links (/join/<token>)
# and as an always-allowed browser origin. No frontend yet: point it at the API.
# Once Next.js exists use e.g. http://localhost:3000 (extra origins: ALLOWED_ORIGINS=a,b).
APP_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=
# Defaults to true when APP_BASE_URL is https. Secure cookies use the __Host- prefix.
COOKIE_SECURE=false
SESSION_TTL=720h
# Set true only when behind a reverse proxy you control (reads X-Forwarded-For).
TRUST_PROXY=false

DATABASE_URL=postgres://open_suite:open_suite@localhost:5432/open_suite?sslmode=disable
DATABASE_MAX_OPEN_CONNS=10
DATABASE_MIN_CONNS=1
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m

REDIS_ADDR=localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# Google OAuth (login + Calendar). See README "Google Cloud setup".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
GOOGLE_CALENDAR_REDIRECT_URL=http://localhost:8080/api/v1/calendar/callback

# 32 bytes: 64 hex chars, base64, or a raw 32 char string. Encrypts Google refresh tokens
# and signs OAuth state cookies. Generate: openssl rand -hex 32
TOKEN_ENC_KEY=

UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880
SCHEDULE_GRANULARITY_MIN=5

# LOCAL TESTING ONLY: enables POST /api/v1/auth/dev-login (sign in without Google).
DEV_LOGIN_ENABLED=false

RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_INVITE_PER_MIN=60
RATE_LIMIT_UPLOAD_PER_MIN=30
RATE_LIMIT_SCHEDULE_PER_MIN=240
